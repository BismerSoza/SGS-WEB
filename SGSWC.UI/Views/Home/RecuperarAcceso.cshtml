@model UsuarioModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    Layout = "_LayoutExterno";
    ViewData["Title"] = Localizer["RecoverAccessTitle"];
}

<style>
    /* Botón personalizado con color exacto #696cff */
    .btn-custom-primary {
        background-color: #696cff !important;
        border-color: #696cff !important;
        color: #fff !important;
    }

        .btn-custom-primary:hover {
            background-color: #5a5cdf !important;
            border-color: #5a5cdf !important;
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(105, 108, 255, 0.35);
        }

    /* Enlace "Volver" más oscuro */
    .link-back-custom {
        color: #4a4bb5 !important;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.15s ease;
    }

        .link-back-custom:hover {
            color: #3a3b95 !important;
            text-decoration: underline;
        }
</style>

<div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner py-4">
        <div class="card">
            <div class="card-body">
                <div class="app-brand justify-content-center">
                    <a href="index.html" class="app-brand-link gap-2">
                        <img src="~/lib/img/logo2.png" alt="46" width="30" style="width: 26px; margin-right: 8px;" />
                        <span class="app-brand-text demo text-body fw-bolder">@Localizer["RecoverAccessTitle"]</span>
                    </a>
                </div>

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-primary text-center">
                        @ViewBag.Mensaje
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-primary text-center">
                        @ViewBag.Error
                    </div>
                }

                <form id="FormRecuperarAcceso" class="mb-3">
                    <div class="mb-3">
                        <label for="email" class="form-label">@Localizer["Email"]</label>
                        <input type="email" class="form-control" asp-for="Correo" id="correo" />
                    </div>
                    <button id="btn-procesar" class="btn btn-custom-primary d-grid w-100" type="submit">@Localizer["Process"]</button>
                </form>

                <div class="text-center">
                    <a asp-controller="Home" asp-action="Index" class="link-back-custom">
                        <i class="bx bx-arrow-back me-1"></i> @Localizer["Back"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    window.translations = {
        successTitle: '@Localizer["SuccessTitle"]',
        errorTitle: '@Localizer["ErrorTitle"]'
    };
</script>

<script src="~/js/RecuperarAcceso.js" asp-append-version="true"></script>