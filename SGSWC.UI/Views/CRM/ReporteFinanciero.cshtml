@model (DateTime fechaDesde, DateTime fechaHasta) 
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer


@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = Localizer["FinancialReportTitle"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold py-1 mb-2">
                <i class="bx bx-line-chart me-1"></i> @Localizer["FinancialReport"]
            </h4>
            <p class="text-muted">@Localizer["FinancialReportDescription"]</p>
        </div>
    </div>

    @* Escenario 2 y 3: mensajes de ausencia de registros o error de procesamiento *@
    @if (TempData["ErrorReporteFinanciero"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle me-1"></i>
            @TempData["ErrorReporteFinanciero"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bx bx-filter-alt me-1"></i> @Localizer["ConfigureReport"]
                    </h5>
                </div>
                <div class="card-body">

                    <form id="formReporteFinanciero" method="get" asp-action="ExportarReporteFinanciero" asp-controller="Crm">

                        <!-- Rango de fechas -->
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label for="fechaDesde" class="form-label fw-semibold">
                                    <i class="bx bx-calendar me-1"></i> @Localizer["DateFrom"]
                                </label>
                                <input type="date" id="fechaDesde" name="fechaDesde" class="form-control"
                                       value="@DateTime.Now.ToString("yyyy-MM-01")" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="fechaHasta" class="form-label fw-semibold">
                                    <i class="bx bx-calendar-check me-1"></i> @Localizer["DateTo"]
                                </label>
                                <input type="date" id="fechaHasta" name="fechaHasta" class="form-control"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <!-- Formato -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bx bx-file me-1"></i> @Localizer["ExportFormat"]
                            </label>
                            <div class="row g-3">
                                <!-- Opción Excel -->
                                <div class="col-md-6">
                                    <div class="card border-2 h-100 formato-card" data-formato="excel" style="cursor:pointer; border-color: #e5e7eb;">
                                        <div class="card-body text-center py-4">
                                            <div class="mb-3">
                                                <span class="avatar avatar-lg bg-label-success" style="width:56px; height:56px;">
                                                    <i class="bx bx-spreadsheet fs-2"></i>
                                                </span>
                                            </div>
                                            <h6 class="fw-bold mb-1">@Localizer["ExcelOption"]</h6>
                                            <small class="text-muted">@Localizer["ExcelDetail"]</small>
                                        </div>
                                    </div>
                                </div>
                                <!-- Opción PDF -->
                                <div class="col-md-6">
                                    <div class="card border-2 h-100 formato-card" data-formato="pdf" style="cursor:pointer; border-color: #e5e7eb;">
                                        <div class="card-body text-center py-4">
                                            <div class="mb-3">
                                                <span class="avatar avatar-lg bg-label-danger" style="width:56px; height:56px;">
                                                    <i class="bx bxs-file-pdf fs-2"></i>
                                                </span>
                                            </div>
                                            <h6 class="fw-bold mb-1">@Localizer["PdfOption"]</h6>
                                            <small class="text-muted">@Localizer["PdfDetail"]</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="formato" name="formato" value="" />
                            <div id="mensajeFormato" class="text-danger small mt-2 d-none">
                                <i class="bx bx-error-circle me-1"></i> @Localizer["SelectExportFormat"]
                            </div>
                        </div>

                        <!-- Resumen informativo -->
                        <div class="alert alert-info d-flex align-items-start" role="alert">
                            <i class="bx bx-info-circle me-2 fs-5"></i>
                            <div>
                                @Localizer["ReportSummary"]
                            </div>
                        </div>

                        <!-- Botón generar -->
                        <div class="d-grid">
                            <button type="submit" id="btnGenerar" class="btn btn-primary btn-lg">
                                <i class="bx bx-download me-1"></i> @Localizer["GenerateFinancialReport"]
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Obtener mensajes localizados desde el servidor
    const dateErrorMsg = '@Localizer["DateFromCannotBeGreater"]';

    const tarjetasFinanciero = document.querySelectorAll('#formReporteFinanciero .formato-card');
    const inputFormatoFinanciero = document.getElementById('formato');
    const mensajeFormatoFinanciero = document.getElementById('mensajeFormato');
    const formReporteFinanciero = document.getElementById('formReporteFinanciero');
    const fechaDesdeInput = document.getElementById('fechaDesde');
    const fechaHastaInput = document.getElementById('fechaHasta');

    tarjetasFinanciero.forEach(tarjeta => {
        tarjeta.addEventListener('click', () => {
            tarjetasFinanciero.forEach(c => {
                c.style.borderColor = '#e5e7eb';
                c.classList.remove('shadow');
            });

            tarjeta.style.borderColor = '#4f46e5';
            tarjeta.classList.add('shadow');

            inputFormatoFinanciero.value = tarjeta.dataset.formato;
            mensajeFormatoFinanciero.classList.add('d-none');
        });
    });

    formReporteFinanciero.addEventListener('submit', (e) => {
        if (!inputFormatoFinanciero.value) {
            e.preventDefault();
            mensajeFormatoFinanciero.classList.remove('d-none');
            return;
        }

        if (fechaDesdeInput.value && fechaHastaInput.value && fechaDesdeInput.value > fechaHastaInput.value) {
            e.preventDefault();
            alert(dateErrorMsg);
        }
    });
</script>