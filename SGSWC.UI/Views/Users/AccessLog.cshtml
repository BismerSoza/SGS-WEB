@model IEnumerable<SGSWC.UI.Models.HistorialAccesoUIModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["AccessLogTitle"];
    Layout = "_LayoutInterno";
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var langCode = culture.TwoLetterISOLanguageName;
    var dataTableLang = langCode == "es" ? "es-ES" : "en-GB";
}

@* DataTables CSS *@
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<style>
    #formFiltroFechas {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }

        #formFiltroFechas .form-label {
            margin-bottom: 0;
            margin-right: .35rem;
            font-size: .8rem;
            white-space: nowrap;
        }

        #formFiltroFechas .form-control {
            width: auto;
        }

    #dtDateFilterSlot {
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="card mb-4 mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="text-center flex-grow-1 m-0">@Localizer["AccessLogTitle"]</h4>
    </div>
    <div class="card-body">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center fw-bold">@ViewBag.Error</div>
        }

        <form id="formFiltroFechas" method="get" asp-action="AccessLog" asp-controller="Users" class="d-none">
            <label class="form-label">@Localizer["StartDate"]</label>
            <input type="date" class="form-control form-control-sm" name="fechaInicio" value="@ViewBag.FechaInicio" />

            <label class="form-label">@Localizer["EndDate"]</label>
            <input type="date" class="form-control form-control-sm" name="fechaFin" value="@ViewBag.FechaFin" />

            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Filter"]</button>
            <a asp-action="AccessLog" asp-controller="Users" class="btn btn-outline-secondary btn-sm">@Localizer["Clear"]</a>
        </form>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">@Localizer["NoAccessRecords"]</div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tablaAccesos" class="table table-hover align-middle w-100">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>@Localizer["User"]</th>
                            <th>@Localizer["Email"]</th>
                            <th>@Localizer["Event"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["DateTime"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id_Acceso</td>
                                <td>@item.Nombre_Usuario</td>
                                <td>@item.Correo</td>
                                <td>
                                    <span class="badge @(item.Tipo_Evento == "Login" ? "bg-success" :
                                                                                                  item.Tipo_Evento == "Login fallido" ? "bg-danger" :
                                                                                                  item.Tipo_Evento == "Logout" ? "bg-secondary" : "bg-info")">
                                        @(item.Tipo_Evento == "Login" ? Localizer["Login"] :
                                          item.Tipo_Evento == "Login fallido" ? Localizer["LoginFailed"] :
                                          item.Tipo_Evento == "Logout" ? Localizer["Logout"] :
                                          item.Tipo_Evento)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(item.Exitoso ? "bg-success" : "bg-danger")">
                                        @(item.Exitoso ? Localizer["Successful"] : Localizer["Failed"])
                                    </span>
                                </td>
                                <td>@item.Fecha</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* DataTables JS *@
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    window.translations = {
        dataTableLanguageUrl: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(dataTableLang).json'
    };
    window.locale = '@langCode';

    $(document).ready(function() {
        $('#tablaAccesos').DataTable({
            language: {
                url: window.translations.dataTableLanguageUrl
            },
            order: [[5, 'desc']], // Ordena por Fecha/Hora (columna índice 5) de más nuevo a más antiguo
            pageLength: 10,
            dom: '<"row mb-2 align-items-center"' +
                '<"col-md-3"l>' +
                '<"#dtDateFilterSlot.col-md-6">' +
                '<"col-md-3"f>' +
                '>rtip',
            initComplete: function() {
                $('#formFiltroFechas')
                    .removeClass('d-none')
                    .appendTo('#dtDateFilterSlot');
            }
        });
    });
</script>