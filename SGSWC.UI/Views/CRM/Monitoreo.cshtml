@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer

@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = Localizer["MonitoringSystemPerformanceTitle"];
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold py-1 mb-2">
                <i class="bx bx-pulse me-1"></i> @Localizer["MonitoringSystemPerformanceTitle"]
            </h4>
            <p class="text-muted mb-0">@Localizer["MonitoringSystemPerformanceSubtitle"]</p>
        </div>
    </div>

    <div id="alertaDegradado" class="alert alert-danger d-none mb-4">
        <i class="bx bx-error-circle me-1"></i>
        <span id="mensajeDegradado"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">@Localizer["AverageResponseTime"]</h6>
                    <h2 id="tiempoPromedio" class="mb-0">--</h2>
                    <small class="text-muted">@Localizer["Milliseconds"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">@Localizer["ActiveRequests"]</h6>
                    <h2 id="solicitudesActivas" class="mb-0">--</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">@Localizer["GeneralStatus"]</h6>
                    <h2 id="estadoSistema" class="mb-0">
                        <span class="badge bg-label-secondary">@Localizer["Loading"]</span>
                    </h2>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Traducciones inyectadas desde el servidor
        const txtDegradado = '@Localizer["SystemSlowAlert"]';
        const txtEstadoDegradado = '@Localizer["Degraded"]';
        const txtEstadoNormal = '@Localizer["Normal"]';
        const txtBadgeDegradado = '<span class="badge bg-danger">' + txtEstadoDegradado + '</span>';
        const txtBadgeNormal = '<span class="badge bg-success">' + txtEstadoNormal + '</span>';

        async function actualizarEstado() {
            try {
                const respuesta = await fetch('/Crm/ObtenerEstadoSistema');
                if (!respuesta.ok) return;
                const datos = await respuesta.json();

                document.getElementById('tiempoPromedio').textContent = datos.tiempoRespuestaPromedioMs.toFixed(0);
                document.getElementById('solicitudesActivas').textContent = datos.solicitudesActivas;

                const badge = datos.estadoSistema === 'Degradado'
                    ? txtBadgeDegradado
                    : txtBadgeNormal;
                document.getElementById('estadoSistema').innerHTML = badge;

                const alerta = document.getElementById('alertaDegradado');
                const mensaje = document.getElementById('mensajeDegradado');
                if (datos.estadoSistema === 'Degradado') {
                    alerta.classList.remove('d-none');
                    mensaje.textContent = txtDegradado;
                } else {
                    alerta.classList.add('d-none');
                }
            } catch (e) {
                console.error('Error al consultar el estado del sistema', e);
            }
        }

        actualizarEstado();
        setInterval(actualizarEstado, 5000); // refresca cada 5s
    </script>
}