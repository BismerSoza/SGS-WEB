@model IEnumerable<SGSWC.UI.Models.ServicioModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "Web Clean | " + Localizer["ProfessionalCleaningServices"];
}

<style>
    .service-card-landing img {
        height: 220px;
        object-fit: cover;
    }
</style>

<div class="container-fluid pb-5 hero-header bg-light mb-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6">
                <h1 class="display-1 mb-4 animated slideInRight">
                    @Localizer["HeroTitle"] <span class="text-primary">@Localizer["HeroTitleHighlight"]</span>
                </h1>
                <p class="mb-4">
                    @Localizer["HeroSubtitle"]
                </p>
                <a asp-controller="Usuarios" asp-action="Service" class="btn btn-primary py-3 px-5">@Localizer["ViewServices"]</a>
            </div>
            <div class="col-lg-6">
                <div class="owl-carousel header-carousel animated fadeIn">
                    <img class="img-fluid" src="~/img/hero-slider-1.jpg" alt="@Localizer["ResidentialCleaningAlt"]">
                    <img class="img-fluid" src="~/img/hero-slider-2.jpg" alt="@Localizer["OfficeCleaningAlt"]">
                    <img class="img-fluid" src="~/img/hero-slider-3.jpg" alt="@Localizer["CommercialCleaningAlt"]">
                </div>
            </div>
        </div>
        <div class="row g-5 animated fadeIn">
            <div class="col-md-6 col-lg-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 btn-square border border-2 border-white me-3">
                        <i class="fa fa-home text-primary"></i>
                    </div>
                    <h5 class="lh-base mb-0">@Localizer["ResidentialCleaningTitle"]</h5>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 btn-square border border-2 border-white me-3">
                        <i class="fa fa-building text-primary"></i>
                    </div>
                    <h5 class="lh-base mb-0">@Localizer["OfficeCleaningTitle"]</h5>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 btn-square border border-2 border-white me-3">
                        <i class="fa fa-store text-primary"></i>
                    </div>
                    <h5 class="lh-base mb-0">@Localizer["CommercialCleaningTitle"]</h5>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 btn-square border border-2 border-white me-3">
                        <i class="fa fa-school text-primary"></i>
                    </div>
                    <h5 class="lh-base mb-0">@Localizer["EducationalCleaningTitle"]</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="row">
                    <div class="col-6 wow fadeIn" data-wow-delay="0.1s">
                        <img class="img-fluid" src="~/img/about-1.jpg" alt="@Localizer["CleaningTeamAlt"]">
                    </div>
                    <div class="col-6 wow fadeIn" data-wow-delay="0.3s">
                        <img class="img-fluid h-100" src="~/img/about-2.jpg" alt="@Localizer["CleanSpaceAlt"]">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="mb-5">
                    <span class="text-uppercase text-primary bg-light px-2">@Localizer["WhoWeAre"]</span> @Localizer["WhoWeAreTitle"]
                </h1>
                <p class="mb-4">
                    @Localizer["WhoWeAreDesc1"]
                </p>
                <p class="mb-4">
                    @Localizer["WhoWeAreDesc2"]
                </p>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>@Localizer["OnlineBooking"]</h6>
                        <h6 class="mb-0"><i class="fa fa-check text-primary me-2"></i>@Localizer["TrainedStaff"]</h6>
                    </div>
                    <div class="col-sm-6">
                        <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>@Localizer["ServiceTracking"]</h6>
                        <h6 class="mb-0"><i class="fa fa-check text-primary me-2"></i>@Localizer["ClearPrices"]</h6>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="container">
        <div class="text-center wow fadeIn" data-wow-delay="0.1s">
            <h1 class="mb-5">
                @Localizer["WhyChooseTitle"] <span class="text-uppercase text-primary bg-light px-2">@Localizer["WhyChooseHighlight"]</span>
            </h1>
        </div>
        <div class="row g-5 align-items-center text-center">
            <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.1s">
                <i class="fa fa-calendar-alt fa-5x text-primary mb-4"></i>
                <h4>@Localizer["FlexibleSchedule"]</h4>
                <p class="mb-0">@Localizer["FlexibleScheduleDesc"]</p>
            </div>
            <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.3s">
                <i class="fa fa-tasks fa-5x text-primary mb-4"></i>
                <h4>@Localizer["AttentionToDetail"]</h4>
                <p class="mb-0">@Localizer["AttentionToDetailDesc"]</p>
            </div>
            <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.5s">
                <i class="fa fa-pencil-ruler fa-5x text-primary mb-4"></i>
                <h4>@Localizer["TrainedTeam"]</h4>
                <p class="mb-0">@Localizer["TrainedTeamDesc"]</p>
            </div>
            <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.1s">
                <i class="fa fa-user fa-5x text-primary mb-4"></i>
                <h4>@Localizer["CustomerFocus"]</h4>
                <p class="mb-0">@Localizer["CustomerFocusDesc"]</p>
            </div>
            <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.3s">
                <i class="fa fa-hand-holding-usd fa-5x text-primary mb-4"></i>
                <h4>@Localizer["ClearPricing"]</h4>
                <p class="mb-0">@Localizer["ClearPricingDesc"]</p>
            </div>
            <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.5s">
                <i class="fa fa-check fa-5x text-primary mb-4"></i>
                <h4>@Localizer["SafeProducts"]</h4>
                <p class="mb-0">@Localizer["SafeProductsDesc"]</p>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="text-center mb-5 wow fadeIn" data-wow-delay="0.1s">
            <h1 class="mb-4">
                @Localizer["OurServicesTitle"] <span class="text-uppercase text-primary bg-light px-2">@Localizer["OurServicesHighlight"]</span>
            </h1>
            <p class="w-75 mx-auto">
                @Localizer["OurServicesDesc"]
            </p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">@Localizer["NoServicesAvailable"]</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                @foreach (var servicio in Model)
                {
                    <div class="col wow fadeIn" data-wow-delay="0.2s">
                        <div class="card service-card-landing h-100 shadow-sm">
                            <img src="@(string.IsNullOrEmpty(servicio.Imagen_Ruta) ? Url.Content("~/lib/img/services/default-service.jpg") : servicio.Imagen_Ruta)"
                                 class="card-img-top"
                                 loading="lazy"
                                 alt="@servicio.Nombre" />
                            <div class="card-body text-center d-flex flex-column">
                                <h5 class="card-title">@servicio.Nombre</h5>
                                <p class="card-text flex-grow-1">@servicio.Descripcion</p>
                                <p class="fw-bold text-primary mb-3">@($"₡{servicio.Precio_Base:N2}")</p>
                                <a asp-controller="Home" asp-action="Index"
                                   asp-route-returnUrl="@Url.Action("ReservarServicio", "Inicio", new { idServicio = servicio.Id_Servicio })"
                                   class="btn btn-primary mt-auto">
                                    @Localizer["BookButton"]
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-12 col-lg-9">
                <div class="owl-carousel testimonial-carousel wow fadeIn" data-wow-delay="0.2s">
                    <div class="testimonial-item">
                        <div class="row g-5 align-items-center">
                            <div class="col-md-6">
                                <div class="testimonial-img">
                                    <img class="img-fluid" src="~/img/testimonial-1.jpg" alt="@Localizer["SatisfiedClientAlt"]">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="testimonial-text pb-5 pb-md-0">
                                    <h3>@Localizer["ResidentialCleaningTitle"]</h3>
                                    <p>
                                        "@Localizer["Testimonial1"]"
                                    </p>
                                    <h5 class="mb-0">@Localizer["Testimonial1Author"]</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-item">
                        <div class="row g-5 align-items-center">
                            <div class="col-md-6">
                                <div class="testimonial-img">
                                    <img class="img-fluid" src="~/img/testimonial-2.jpg" alt="@Localizer["SatisfiedClientAlt"]">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="testimonial-text pb-5 pb-md-0">
                                    <h3>@Localizer["OfficeCleaningTitle"]</h3>
                                    <p>
                                        "@Localizer["Testimonial2"]"
                                    </p>
                                    <h5 class="mb-0">@Localizer["Testimonial2Author"]</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-item">
                        <div class="row g-5 align-items-center">
                            <div class="col-md-6">
                                <div class="testimonial-img">
                                    <img class="img-fluid" src="~/img/testimonial-3.jpg" alt="@Localizer["SatisfiedClientAlt"]">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="testimonial-text pb-5 pb-md-0">
                                    <h3>@Localizer["CommercialCleaningTitle"]</h3>
                                    <p>
                                        "@Localizer["Testimonial3"]"
                                    </p>
                                    <h5 class="mb-0">@Localizer["Testimonial3Author"]</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>