@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = Localizer["ServiceManagementTitle"];
}

@model List<EstadoServicioModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer

@{
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var langCode = culture.TwoLetterISOLanguageName;
    var dataTableLang = langCode == "es" ? "es-ES" : "en-GB";
}

@* DataTables CSS *@
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<style>
    /* Estilos personalizados para botones con la paleta Sneat */
    .btn-custom-primary {
        background-color: #696cff !important;
        border-color: #696cff !important;
        color: #fff !important;
    }

        .btn-custom-primary:hover {
            background-color: #5a5cdf !important;
            border-color: #5a5cdf !important;
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(105, 108, 255, 0.35);
        }

    .btn-outline-custom {
        color: #696cff !important;
        border-color: #696cff !important;
        background-color: transparent !important;
    }

        .btn-outline-custom:hover {
            background-color: #696cff !important;
            color: #fff !important;
            border-color: #696cff !important;
            box-shadow: 0 4px 12px rgba(105, 108, 255, 0.25);
        }

    /* Ajuste para que los selects y botones dentro de la tabla se vean bien */
    .table td .form-select-sm {
        width: auto;
        min-width: 120px;
        display: inline-block;
    }

    .table td .btn-sm {
        margin-top: 4px;
    }
    /* Para que el contenedor de la tabla sea scrollable en móviles */
    .table-responsive {
        overflow-x: auto;
    }
</style>

<div class="card mb-4 mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="text-center flex-grow-1 m-0">@Localizer["ServiceManagementTitle"]</h4>
    </div>
    <div class="card-body">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class='bx bx-check-circle me-1'></i> @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Advertencia"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class='bx bx-error me-1'></i> @TempData["Advertencia"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class='bx bx-x-circle me-1'></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bx bx-info-circle me-1"></i> @Localizer["NoServicesAvailable"]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tablaServicios" class="table table-hover align-middle w-100">
                    <thead class="table-primary">
                        <tr>
                            <th>@Localizer["Client"]</th>
                            <th>@Localizer["Service"]</th>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["ChangeStatus"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Cliente</td>
                                <td>@item.Servicio</td>
                                <td>@item.FechaServicio.ToShortDateString()</td>

                                <td>
                                    @switch (item.EstadoActual)
                                    {
                                        case "Pendiente":
                                            <span class="badge bg-warning text-dark">@Localizer["Pending"]</span>
                                            break;
                                        case "Aceptado":
                                            <span class="badge bg-info text-dark">@Localizer["Accepted"]</span>
                                            break;
                                        case "Confirmada":
                                            <span class="badge bg-primary">@Localizer["Confirmed"]</span>
                                            break;
                                        case "Completada":
                                            <span class="badge bg-success">@Localizer["Completed"]</span>
                                            break;
                                        case "Cancelada":
                                            <span class="badge bg-danger">@Localizer["Cancelled"]</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.EstadoActual</span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (item.EstadoActual != "Completada" && item.EstadoActual != "Cancelada")
                                    {
                                        <form asp-action="CambiarEstadoServicio" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                            <input type="hidden" name="idReservacion" value="@item.IdReservacion" />

                                            <select class="form-select form-select-sm" name="idEstadoNuevo" style="width:auto; min-width:120px;">
                                                <option value="1" selected="@(item.IdEstadoActual == 1)">@Localizer["Pending"]</option>
                                                <option value="5" selected="@(item.IdEstadoActual == 5)">@Localizer["Accepted"]</option>
                                                <option value="2" selected="@(item.IdEstadoActual == 2)">@Localizer["Confirmed"]</option>
                                                <option value="4" selected="@(item.IdEstadoActual == 4)">@Localizer["Completed"]</option>
                                                <option value="3" selected="@(item.IdEstadoActual == 3)">@Localizer["Cancelled"]</option>
                                            </select>

                                            <button class="btn btn-custom-primary btn-sm">@Localizer["Update"]</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@Localizer["FinalStatus"]</span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Historial"
                                       asp-route-idReservacion="@item.IdReservacion"
                                       class="btn btn-outline-custom btn-sm">
                                        @Localizer["ViewHistory"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* DataTables JS *@
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    // Inyectar traducciones y configuración de idioma
    window.translations = {
        dataTableLanguageUrl: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(dataTableLang).json'
    };
    window.locale = '@langCode';

    $(document).ready(function() {
        @if (Model != null && Model.Any())
            {
                <text>
                        $('#tablaServicios').DataTable({
                            language: {
                            url: window.translations.dataTableLanguageUrl
                                        },
                        order: [[2, 'asc']], // Ordenar por fecha (columna índice 2) ascendente
                        pageLength: 10,
                        columnDefs: [
                        // Deshabilitar ordenamiento en columnas con formularios (ChangeStatus y ViewHistory)
                        {orderable: false, targets: [4, 5] }
                        ]
                                    });
                </text>
        }
            });
</script>