@model IEnumerable<SGSWC.UI.Models.ServicioModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "Web Clean | " + Localizer["OurServicesTitle"];
}

<style>
    .service-card-landing img {
        height: 220px;
        object-fit: cover;
    }

    .service-card-landing .card-body {
        display: flex;
        flex-direction: column;
    }

    .service-card-landing .card-text {
        flex-grow: 1;
    }
</style>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="text-center mb-5 wow fadeIn" data-wow-delay="0.1s">
            <h1 class="mb-4">
                @Localizer["OurServicesTitle"] <span class="text-uppercase text-primary bg-light px-2">@Localizer["OurServicesHighlight"]</span>
            </h1>
            <p class="w-75 mx-auto">
                @Localizer["OurServicesDesc"]
            </p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">@Localizer["NoServicesAvailable"]</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                @foreach (var servicio in Model)
                {
                    <div class="col wow fadeIn" data-wow-delay="0.2s">
                        <div class="card service-card-landing h-100 shadow-sm">
                            <img src="@(string.IsNullOrEmpty(servicio.Imagen_Ruta) ? Url.Content("~/lib/img/services/default-service.jpg") : servicio.Imagen_Ruta)"
                                 class="card-img-top"
                                 loading="lazy"
                                 alt="@servicio.Nombre" />
                            <div class="card-body text-center">
                                <h5 class="card-title">@servicio.Nombre</h5>
                                <p class="card-text">@servicio.Descripcion</p>
                                <p class="fw-bold text-primary mb-0">@($"${(servicio.Precio_Base / 500):N2}")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>