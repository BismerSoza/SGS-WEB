@model List<SGSWC.UI.Models.Reseña>
@{
    ViewData["Title"] = "Reseñas";
    Layout = "_LayoutInterno";
    var servicio = ViewData["Servicio"] as string;
}

<section class="mb-5">
    <h2 class="text-primary text-center mb-4">Reseñas del servicio @servicio</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success text-center fw-bold">@TempData["Mensaje"]</div>
    }

    @if (Model.Count == 0)
    {
        <p class="text-center text-muted">Todavía no hay reseñas para este servicio.</p>
    }
    else
    {
        <div class="row">
            @foreach (var r in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <!-- Nombre -->
                            <p class="fw-bold mb-1">@(!string.IsNullOrEmpty(r.Cliente) ? r.Cliente : "Anónimo")</p>

                            <!-- Estrellas -->
                            <p class="mb-1 fw-bold" style="color:gold; font-size:1.2rem;">
                                @(new string('★', r.Calificacion))@(new string('☆', 5 - r.Calificacion))
                            </p>

                            <!-- Comentario opcional -->
                            @if (!string.IsNullOrEmpty(r.Comentario))
                            {
                                <p class="mb-2">@r.Comentario</p>
                            }

                            <!-- Imagen opcional -->
                            @if (!string.IsNullOrEmpty(r.ImagenPath))
                            {
                                <img src="@Url.Content(r.ImagenPath)" alt="Imagen reseña" class="img-fluid rounded mt-2" style="max-width:200px;" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Botón para mostrar/ocultar el formulario -->
    <div class="text-center mt-4">
        <button class="btn btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#formReseña" aria-expanded="false" aria-controls="formReseña">
            Añadir Reseña
        </button>
    </div>

    <!-- Formulario oculto -->
    <div class="collapse mt-4" id="formReseña">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Agregar reseña</h5>
                <form asp-action="AgregarReseña" asp-controller="Inicio" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="servicio" value="@servicio" />

                    <!-- Nombre obligatorio -->
                    <div class="mb-3">
                        <label for="cliente" class="form-label">Tu nombre</label>
                        <input type="text" class="form-control" id="cliente" name="cliente" required />
                    </div>

                    <!-- Estrellas obligatorias -->
                    <div class="mb-3">
                        <label for="calificacion" class="form-label">Calificación</label>
                        <select class="form-select" id="calificacion" name="calificacion" required>
                            <option value="5">★★★★★ - Excelente</option>
                            <option value="4">★★★★☆ - Muy bueno</option>
                            <option value="3">★★★☆☆ - Bueno</option>
                            <option value="2">★★☆☆☆ - Regular</option>
                            <option value="1">★☆☆☆☆ - Malo</option>
                        </select>
                    </div>

                    <!-- Comentario opcional -->
                    <div class="mb-3">
                        <label for="comentario" class="form-label">Comentario (opcional)</label>
                        <textarea class="form-control" id="comentario" name="comentario" rows="3"></textarea>
                    </div>

                    <!-- Imagen opcional -->
                    <div class="mb-3">
                        <label for="imagen" class="form-label">Imagen del servicio (opcional)</label>
                        <input type="file" class="form-control" id="imagen" name="imagen" accept="image/*" />
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-success">Guardar Reseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
