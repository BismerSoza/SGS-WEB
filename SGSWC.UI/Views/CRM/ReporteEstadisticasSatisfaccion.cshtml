@model ReporteEstadisticasSatisfaccionResponseModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer


@{
    Layout = "_LayoutInterno";
    ViewData["Title"] = Localizer["SatisfactionStatisticsTitle"];
    var kpis = Model.Kpis;
    var varClase = kpis.VariacionPromedio >= 0 ? "text-success" : "text-danger";
    var varIcono = kpis.VariacionPromedio >= 0 ? "bx-up-arrow-alt" : "bx-down-arrow-alt";
    var varTexto = kpis.VariacionPromedio >= 0 ? $"+{kpis.VariacionPromedio.ToString("F1")}%" : $"{kpis.VariacionPromedio.ToString("F1")}%";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Encabezado -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-0">
                <i class="bx bx-star me-2 text-warning"></i>@Localizer["SatisfactionStatistics"]
            </h4>
            <small class="text-muted">
                @Localizer["PeriodLabel"] @kpis.FechaInicio — @kpis.FechaFin
            </small>
        </div>
    </div>

    <!-- Escenario 3: error -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mb-4">
            <i class="bx bx-error-circle me-1"></i> @ViewBag.Error
        </div>
    }

    <!-- Filtro de fechas -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">@Localizer["DateFrom"]</label>
                    <input type="date" name="fechaInicio" class="form-control"
                           value="@ViewBag.FechaInicio" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Localizer["DateTo"]</label>
                    <input type="date" name="fechaFin" class="form-control"
                           value="@ViewBag.FechaFin" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bx bx-search me-1"></i> @Localizer["Filter"]
                    </button>
                    <a href="@Url.Action("ReporteEstadisticasSatisfaccion")"
                       class="btn btn-outline-secondary w-100">
                        <i class="bx bx-reset me-1"></i> @Localizer["Clear"]
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Escenario 2: sin datos -->
    @if (kpis.TotalResenas == 0 && ViewBag.Error == null)
    {
        <div class="alert alert-info text-center">
            <i class="bx bx-info-circle me-1"></i> @Localizer["NoDataAvailable"]
        </div>
    }
    else if (kpis.TotalResenas > 0)
    {
        <!-- Escenario 1: KPIs -->
        <div class="row mb-4">

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="avatar-initial rounded bg-label-warning p-2 me-2">
                                <i class="bx bx-star fs-5"></i>
                            </span>
                            <span class="text-muted small">@Localizer["AverageRating"]</span>
                        </div>
                        <h3 class="fw-bold mb-1">@kpis.PromedioGeneral.ToString("F1") / 5</h3>
                        <small class="@varClase fw-semibold">
                            <i class="bx @varIcono"></i> @varTexto
                        </small>
                        <small class="text-muted ms-1">@Localizer["VsPreviousPeriod"]</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="avatar-initial rounded bg-label-primary p-2 me-2">
                                <i class="bx bx-comment fs-5"></i>
                            </span>
                            <span class="text-muted small">@Localizer["TotalReviews"]</span>
                        </div>
                        <h3 class="fw-bold mb-1">@kpis.TotalResenas</h3>
                        <small class="text-muted">@Localizer["InPeriod"]</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="avatar-initial rounded bg-label-success p-2 me-2">
                                <i class="bx bx-happy fs-5"></i>
                            </span>
                            <span class="text-muted small">@Localizer["SatisfactionRate"]</span>
                        </div>
                        <h3 class="fw-bold mb-1">@kpis.TasaSatisfaccion.ToString("F1")%</h3>
                        <small class="text-success">@Localizer["PositiveReviewsWith4to5Stars", kpis.TotalPositivas]</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="avatar-initial rounded bg-label-danger p-2 me-2">
                                <i class="bx bx-sad fs-5"></i>
                            </span>
                            <span class="text-muted small">@Localizer["NegativeReviews"]</span>
                        </div>
                        <h3 class="fw-bold mb-1">@kpis.TotalNegativas</h3>
                        <small class="text-danger">@Localizer["With1to2Stars"]</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico + distribución -->
        <div class="row mb-4">

            <div class="col-md-5 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="mb-0">@Localizer["RatingDistribution"]</h5>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <canvas id="graficoDistribucion" height="220"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-md-7 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="mb-0">@Localizer["DetailsByStar"]</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var d in Model.Distribucion.OrderByDescending(x => x.Calificacion))
                        {
                            var colorBarra = d.Calificacion >= 4 ? "bg-success"
                                           : d.Calificacion == 3 ? "bg-warning"
                                           : "bg-danger";
                            <div class="d-flex align-items-center mb-3">
                                <span class="me-2 text-warning fw-bold" style="min-width:50px">
                                    @d.Calificacion ★
                                </span>
                                <div class="progress flex-grow-1 me-2" style="height:18px">
                                    <div class="progress-bar @colorBarra"
                                         style="width:@d.Porcentaje.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                         role="progressbar">
                                    </div>
                                </div>
                                <span class="text-muted small" style="min-width:80px">
                                    @d.Total (@d.Porcentaje.ToString("F1")%)
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ✅ TOP 3 Servicios más solicitados -->
        @if (Model.Servicios.Any())
        {
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">
                        <i class="bx bx-trophy me-2 text-warning"></i>@Localizer["TopServicesTitle"]
                    </h5>
                    <span class="badge bg-label-warning">@Localizer["SelectedPeriod"]</span>
                </div>
                <div class="card-body">
                    @{
                        var maxContrataciones = Model.Servicios.Max(x => x.TotalContrataciones);
                        string[] medallas = {
                            "bx-medal text-warning",    // oro
                            "bx-medal text-secondary",  // plata
                            "bx-medal text-danger"      // bronce
                        };
                    }
                    @foreach (var (s, i) in Model.Servicios.Select((s, i) => (s, i)))
                    {
                        var colorBarra = s.PromedioCalificacion >= 4 ? "bg-success"
                                       : s.PromedioCalificacion >= 3 ? "bg-warning"
                                       : "bg-danger";
                        var pct = maxContrataciones > 0
                            ? ((double)s.TotalContrataciones / maxContrataciones * 100)
                                .ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                            : "0.0";

                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bx @medallas[i] fs-4"></i>
                                    <span class="fw-semibold">@s.NombreServicio</span>
                                </div>
                                <div class="text-muted small">
                                    @Localizer["ContractsCount", s.TotalContrataciones]
                                    &nbsp;|&nbsp;
                                    ★ @s.PromedioCalificacion.ToString("F1")
                                </div>
                            </div>
                            <div class="progress" style="height:14px">
                                <div class="progress-bar @colorBarra"
                                     style="width:@(pct)%"
                                     role="progressbar">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Tabla de detalle -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">@Localizer["ReviewsDetail"]</h5>
                <span class="badge bg-label-primary">@Model.Resenas.Count @Localizer["Records"]</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tablaResenas" class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>@Localizer["Client"]</th>
                                <th>@Localizer["Service"]</th>
                                <th>@Localizer["Rating"]</th>
                                <th>@Localizer["Comment"]</th>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Resenas)
                            {
                                <tr>
                                    <td>@r.NombreCliente</td>
                                    <td>@r.NombreServicio</td>
                                    <td>
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="bx @(s <= r.Calificacion ? "bxs-star text-warning" : "bx-star text-muted")"></i>
                                        }
                                    </td>
                                    <td>
                                        <span title="@r.Comentario">
                                            @(r.Comentario?.Length > 60
                                                ? r.Comentario.Substring(0, 60) + "..."
                                                : r.Comentario)
                                        </span>
                                    </td>
                                    <td>@r.Fecha</td>
                                    <td>
                                        @if (r.Estado == "Respondida")
                                        {
                                            <span class="badge bg-success">@Localizer["Responded"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-label-secondary">@Localizer["NoReply"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chartLabelDistribution = '@Localizer["ChartDistributionLabel"]';

        @if (Model.Kpis.TotalResenas > 0)
            {
                <text>
                        document.addEventListener("DOMContentLoaded", function () {

                                            if (document.getElementById("tablaResenas")) {
                            new DataTable("#tablaResenas", {
                                language: {
                                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                                },
                                pageLength: 10,
                                order: [[4, "desc"]]
                            });
                                            }

                        const distribucion = @Html.Raw(
                                                                                                                                    System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                    Model.Distribucion.OrderBy(x => x.Calificacion)
                                    )
                                    );

                        const colores = ['#dc3545','#fd7e14','#ffc107','#20c997','#28a745'];

                        new Chart(document.getElementById('graficoDistribucion'), {
                            type: 'doughnut',
                        data: {
                            labels: distribucion.map(d => d.Calificacion + ' ★'),
                        datasets: [{
                            data: distribucion.map(d => d.Total),
                        backgroundColor: colores,
                        borderWidth: 2,
                        label: chartLabelDistribution
                                                    }]
                                                },
                        options: {
                            responsive: true,
                        plugins: {
                            legend: {position: 'bottom' }
                                                    }
                                                }
                                            });
                                        });
                </text>
        }
    </script>
}