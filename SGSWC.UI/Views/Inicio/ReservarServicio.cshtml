@model ReservaModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["BookServiceTitle"];
    Layout = "_LayoutInterno";
    var servicios = ViewBag.Servicios as List<ServicioModel> ?? new List<ServicioModel>();
}

<section class="mb-5">
    <h2 class="text-primary text-center mb-4">@Localizer["BookServiceTitle"]</h2>
    <p class="text-muted text-center mb-5">
        @Localizer["BookServiceSubtitle"]
    </p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success text-center fw-bold">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center fw-bold">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="ReservarServicio" asp-controller="Inicio" method="post">

                <div class="mb-3">
                    <label class="form-label">@Localizer["Service"]</label>
                    <select class="form-select" asp-for="Id_Servicio" required>
                        <option value="">@Localizer["SelectService"]</option>
                        @foreach (var servicio in servicios)
                        {
                            <option value="@servicio.Id_Servicio">
                                @servicio.Nombre — @Localizer["CurrencySymbol"]@servicio.Precio_Base.ToString("N2")
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">@Localizer["Date"]</label>
                    <input type="date" class="form-control" asp-for="Fecha"
                           required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label">@Localizer["Time"]</label>
                    <input type="time" class="form-control" asp-for="Hora" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">@Localizer["Address"]</label>
                    <input type="text" class="form-control" asp-for="Direccion_Servicio" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">@Localizer["Observations"]</label>
                    <textarea class="form-control" asp-for="Observaciones" rows="3"></textarea>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success fw-bold">@Localizer["BookButton"]</button>
                </div>

            </form>
        </div>
    </div>
</section>