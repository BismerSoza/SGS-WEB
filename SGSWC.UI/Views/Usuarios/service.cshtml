@model IEnumerable<SGSWC.UI.Models.ServicioModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "Web Clean | " + Localizer["ServicesTitle"];
}

<style>
    .service-card-landing img {
        height: 220px;
        object-fit: cover;
    }
</style>

<div class="container-fluid pb-5 bg-primary hero-header">
    <div class="container py-5">
        <div class="row g-3 align-items-center">
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-1 mb-0 animated slideInLeft">@Localizer["ServicesHeroTitle"]</h1>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <h1 class="mb-4">
                    @Localizer["OurServicesTitle"] <span class="text-uppercase text-primary bg-light px-2">@Localizer["OurServicesHighlight"]</span>
                </h1>
                <p>
                    @Localizer["ServicesDesc1"]
                </p>
                <p class="mb-0">
                    @Localizer["ServicesDesc2"]
                </p>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">@Localizer["NoServicesAvailable"]</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                @foreach (var servicio in Model)
                {
                    <div class="col wow fadeIn" data-wow-delay="0.2s">
                        <div class="card service-card-landing h-100 shadow-sm">
                            <img src="@(string.IsNullOrEmpty(servicio.Imagen_Ruta) ? Url.Content("~/lib/img/services/default-service.jpg") : servicio.Imagen_Ruta)"
                                 class="card-img-top"
                                 loading="lazy"
                                 alt="@servicio.Nombre" />
                            <div class="card-body text-center d-flex flex-column">
                                <h5 class="card-title">@servicio.Nombre</h5>
                                <p class="card-text flex-grow-1">@servicio.Descripcion</p>
                                <p class="fw-bold text-primary mb-3">@($"₡{servicio.Precio_Base:N2}")</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-controller="Usuarios" asp-action="Details"
                                       asp-route-id="@servicio.Id_Servicio"
                                       class="btn btn-outline-primary">
                                        @Localizer["ViewDetail"]
                                    </a>
                                    <a asp-controller="Home" asp-action="Index"
                                       asp-route-returnUrl="@Url.Action("ReservarServicio", "Inicio", new { idServicio = servicio.Id_Servicio })"
                                       class="btn btn-primary">
                                        @Localizer["BookButton"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>