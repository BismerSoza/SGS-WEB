@model SGSWC.UI.Models.UsuarioModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SGSWC.UI.SharedResource> Localizer
@{
    Layout = "_LayoutExterno";
    ViewData["Title"] = Localizer["LoginTitle"];
}

<style>
    /* Botón personalizado con color exacto #696cff */
    .btn-custom-primary {
        background-color: #696cff !important;
        border-color: #696cff !important;
        color: #fff !important;
    }

        .btn-custom-primary:hover {
            background-color: #5a5cdf !important;
            border-color: #5a5cdf !important;
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(105, 108, 255, 0.35);
        }

    /* Enlaces más oscuros */
    .link-custom-dark {
        color: #4a4bb5 !important;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.15s ease;
    }

        .link-custom-dark:hover {
            color: #3a3b95 !important;
            text-decoration: underline;
        }

    /* Botón volver al landing */
    .btn-back-home {
        background-color: #6c757d !important;
        border-color: #6c757d !important;
        color: #fff !important;
    }

        .btn-back-home:hover {
            background-color: #5a6268 !important;
            border-color: #545b62 !important;
            color: #fff !important;
        }
</style>

<div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
        <div class="card">
            <div class="card-body">
                <div class="app-brand justify-content-center">
                    <img src="~/lib/img/logo2.png" alt="46" width="30" style="width: 26px; margin-right: 8px;" />
                    <span class="app-brand-text demo text-body fw-bolder">@Localizer["LoginTitle"]</span>
                </div>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success text-center">@TempData["Mensaje"]</div>
                }

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-danger text-center">@ViewBag.Mensaje</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger text-center">@TempData["Error"]</div>
                }

                <form asp-action="Index" asp-controller="Home" method="post">
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Email"]</label>
                        <input type="email" class="form-control" asp-for="Correo" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Password"]</label>
                        <input type="password" class="form-control" asp-for="Contrasena_hash" required />
                    </div>
                    <button type="submit" class="btn btn-custom-primary w-100">@Localizer["LoginButton"]</button>
                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-back-home w-100">
                        <i class="bx bx-home me-1"></i> @Localizer["BackToHome"]
                    </a>
                </div>

                <p class="text-center mt-3">
                    <span>@Localizer["ForgotPassword"]</span>
                    <a asp-controller="Home" asp-action="RecuperarAcceso" class="link-custom-dark">@Localizer["Recover"]</a>
                </p>
                <p class="text-center">
                    <span>@Localizer["NewToSystem"]</span>
                    <a asp-controller="Home" asp-action="Registro" class="link-custom-dark">@Localizer["CreateAccount"]</a>
                </p>
            </div>
        </div>
    </div>
</div>